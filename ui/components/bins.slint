import { Palette, Style, AppFonts } from "../common.slint";


component Bin {
    in property <color> color;
    Text {
        font-size: 48px;
        font-family: AppFonts.icon-font-name;
        color: color;
        text: @tr(""); // https://fontawesome.com/icons/trash-can?f=classic&s=regular
    }
}

export component Bins {
    in property <bool> is-yellow-bin;
    in property <int> days-to-bin;

    HorizontalLayout {
        alignment: start;
        spacing: 24px;

        Bin {
            color: red;
        }

        Bin {
            color: green;
        }

        if(is-yellow-bin): Bin {
            color: yellow;
        }

        Text {
            text: days-to-bin == 0 ? "BIN DAY TODAY" : "Days " + days-to-bin;
            vertical-alignment: center;
            color: Palette.info-foreground;
            font-size: Style.H2-font-size;
        }
    }
}
