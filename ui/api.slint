import { Date, Time } from "std-widgets.slint";

export enum Pages { home, settings }

export enum WeatherType {
    sunny,
    cloudy,
    fog,
    sprinkle,
    snow,
    rain-drop,
    rain-mix,
    snowflake-cold,
    snow-wind,
    rain,
    snow-thunderstorm,
    thunderstorm,
    other,
}

export struct Coordinates  {
    longitude: float,
    latitude: float,
}

export struct WeatherDaily {
    temperature_max: int,
    temperature_min: int,
    date: Date,
    week_day: int,
    precipitation_sum: int,
    precipitation_probability_max: int,
    weather_type: WeatherType,
    sunrise: Time,
    sunset: Time,
}

export struct WeatherHourly {
    temperature: int,
    precipitation_mm: float,
    date: Date,
    time: Time,
}
export struct WeatherCurrent {
    temperature: int,
    precipitation: int,
    weather_type: WeatherType,
}

export global Api {
    in-out property <Pages> current-page: Pages.home;

    in-out property <bool> is-yellow-bin: true;
    in-out property <int> days-to-bin: 0;

    in-out property <WeatherCurrent> weather-current;

    in-out property <[WeatherHourly]> weather-hourly: [
        {
            temperature: 10,
            precipitation_mm: 0.2,
            time: { hour: 16, minute: 0, second: 0 },
            date: { year: 2025, month: 1, day: 1 }
        },
        {
            temperature: 13,
            precipitation_mm: 0,
            time: { hour: 17, minute: 0, second: 0 },
            date: { year: 2025, month: 1, day: 1 }
        },
        {
            temperature: 13,
            precipitation_mm: 0,
            time: { hour: 18, minute: 0, second: 0 },
            date: { year: 2025, month: 1, day: 1 }
        },
        {
            temperature: 14,
            precipitation_mm: 0,
            time: { hour: 19, minute: 0, second: 0 },
            date: { year: 2025, month: 1, day: 1 }
        },
        {
            temperature: 11,
            precipitation_mm: 0,
            time: { hour: 20, minute: 0, second: 0 },
            date: { year: 2025, month: 1, day: 1 }
        },
        {
            temperature: 12,
            precipitation_mm: 0,
            time: { hour: 21, minute: 0, second: 0 },
            date: { year: 2025, month: 1, day: 1 }
        },
        {
            temperature: 10,
            precipitation_mm: 0,
            time: { hour: 22, minute: 0, second: 0 },
            date: { year: 2025, month: 1, day: 1 }
        },
    ];

    in-out property <[WeatherDaily]> weather-daily: [
        {
            week-day: 1,
            temperature_max: 25,
            temperature_min: 0,
            date: { year: 2025, month: 3, day: 18 },
            precipitation_sum: 0.8,
            precipitation_probability_max: 23,
            weather_type: WeatherType.rain,
            sunrise: { hour: 6, minute: 55, second: 0 },
            sunset: { hour: 17, minute: 10, second: 0 },
        },
        {
            week-day: 2,
            temperature_max: 25,
            temperature_min: 10,
            date: { year: 2025, month: 3, day: 18 },
            precipitation_sum: 0,
            precipitation_probability_max: 0,
            weather_type: WeatherType.rain,
            sunrise: { hour: 6, minute: 55, second: 0 },
            sunset: { hour: 17, minute: 10, second: 0 },
        }
    ];

    in-out property <Time> weather-updated-at: {
        hour: 15,
        minute: 12,
        second: 33,
    };

    in-out property <Coordinates> coordinates: {
        latitude: 0,
        latitude: 0,
    };
    callback coordinates-updated(Coordinates);

    in-out property <Date> current-date: {
        year: 2025,
        month: 3,
        day: 18,
    };

    in-out property <Time> current-time: {
        hour: 15,
        minute: 12,
        second: 33,
    };
}
